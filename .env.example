# Copy to .env.local and fill in. Never commit real values.
# Every setting, and where each one is needed, is in docs/setup.md.

# IGDB authenticates through Twitch (client-credentials flow).
# Create an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret

# The database. Leave both out on this machine: without them Shelf uses the
# SQLite file at .data/shelf.db. On Vercel they point at Turso.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

# Set to 1 to answer IGDB, Twitch and GitHub with test doubles instead of the network.
# The browser tests set it themselves. It is refused on Vercel.
# SHELF_MOCKS=1

# Sign-in (docs/setup.md, part C). GitHub OAuth app 2, the local one, whose
# callback is http://localhost:3300/api/auth/callback/github.
# GITHUB_CLIENT_ID=your-local-github-app-client-id
# GITHUB_CLIENT_SECRET=your-local-github-app-client-secret
# Signs sessions and assistants' tokens: a random value, 32 characters or more.
# BETTER_AUTH_SECRET=
# The one GitHub account that may sign in, by its numeric id (public).
# OWNER_GITHUB_ID=
# Only on Vercel, where previews sign in through production.
# OAUTH_PROXY_SECRET=
