{
  "name": "shelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "serve:test": "node scripts/serve-for-tests.ts",
    "vercel-build": "pnpm db:prepare && next build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/i18n-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/db.ts migrate",
    "db:prepare": "tsx --conditions=react-server scripts/db.ts prepare",
    "seed": "tsx --conditions=react-server scripts/db.ts seed",
    "account:password": "tsx --conditions=react-server scripts/account-password.ts",
    "fixtures:fetch": "tsx --conditions=react-server --env-file=.env.local scripts/fixtures-fetch.ts",
    "landing:demo": "tsx --conditions=react-server scripts/landing-demo.ts",
    "landing:share": "node scripts/landing-share.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "perf:js": "node scripts/measure-js.ts",
    "perf:lighthouse": "node scripts/lighthouse.ts",
    "perf:3d": "node scripts/perf-3d.ts",
    "storybook": "storybook dev -p 6300 --no-open",
    "storybook:build": "storybook build",
    "desktop:dev": "node scripts/desktop.ts dev",
    "desktop:build": "node scripts/desktop.ts build",
    "desktop:test": "node scripts/desktop.ts test",
    "desktop:check": "node scripts/desktop-check.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm i18n:check && pnpm test",
    "verify": "node scripts/verify.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@libsql/client": "0.18.0",
    "@modelcontextprotocol/server": "2.3.1",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.55.0",
    "next": "16.4.1",
    "next-intl": "4.14.9",
    "nuqs": "2.10.2",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "thumbhash": "0.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "1.64.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/nextjs-vite": "10.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-storybook": "10.6.2",
    "jsdom": "30.1.2",
    "lighthouse": "13.5.0",
    "msw": "3.0.3",
    "postcss": "^8",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
