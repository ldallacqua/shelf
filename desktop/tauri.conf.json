{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shelf",
  "version": "0.4.0",
  "identifier": "com.ldallacqua.shelf",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Lucas Dall'Acqua",
    "shortDescription": "Shelf, with Play",
    "longDescription": "The Shelf game library in a window of its own, which starts games from their files or through Steam.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "PortugueseBR"],
        "displayLanguageSelector": false,
        "template": "installer/installer.nsi",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxNzkwNUQ1MTYyRkZBRTEKUldUaCtpOFcxUVY1VVVaS0x4VGxPZHNvQW1GM2VjektEMG53QWRjN1R5Z1ltUkQ4bEpYNUhaS0gK",
      "endpoints": ["https://github.com/ldallacqua/shelf/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
